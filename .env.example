# Safe default: no Privy network call, wallet, signer or broadcast capability.
ALICE_GUARD_WALLET_MODE=disabled

# Required only for read-only remote policy and wallet-binding verification.
PRIVY_APP_ID=<set-in-local-secret-store>
PRIVY_APP_SECRET=<set-in-local-secret-store>
PRIVY_POLICY_ID=<existing-policy-id>
PRIVY_WALLET_ID=<existing-wallet-id>
PRIVY_AUTHORIZATION_KEY_ID=<existing-authorization-key-id>

# Reserved for a later, explicitly approved provisioning phase. Base64 PKCS8,
# without PEM headers. Never commit, log, paste into a browser, or write to state.
PRIVY_AUTHORIZATION_PRIVATE_KEY=<base64-pkcs8-local-secret-only>
