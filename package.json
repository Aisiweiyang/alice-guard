{
  "name": "alice-guard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "description": "Deterministic financial risk and policy guard for AI agents",
  "scripts": {
    "check": "tsc --noEmit",
    "demo": "tsx scripts/run-demo.ts",
    "demo:web": "tsx scripts/serve-demo.ts",
    "demo:web:public": "tsx scripts/serve-public-demo.ts",
    "demo:web:live": "node --env-file=.env.local --import tsx scripts/serve-demo.ts --privy-status",
    "evidence:privy": "node --env-file=.env.local --import tsx scripts/export-privy-evidence.ts",
    "evidence:judge": "tsx scripts/export-judge-evidence.ts",
    "evidence:judge:verify": "tsx scripts/verify-judge-evidence.ts",
    "privy:policy:render": "tsx scripts/render-privy-policy.ts",
    "privy:policy:verify": "node --env-file-if-exists=.env.local --import tsx scripts/verify-privy-policy.ts",
    "privy:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-privy-local.ps1",
    "privy:owner:verify": "node --env-file=.env.local --import tsx scripts/verify-privy-owner.ts",
    "privy:wallet:plan": "node --env-file-if-exists=.env.local --import tsx scripts/setup-demo-wallet.ts --dry-run",
    "privy:wallet:provision": "node --env-file=.env.local --import tsx scripts/provision-privy-wallet.ts",
    "privy:wallet:verify": "node --env-file-if-exists=.env.local --import tsx scripts/verify-wallet-policy.ts",
    "privy:wallet:denials": "tsx scripts/test-wallet-policy-denials.ts --dry-run",
    "privy:wallet:revoke:plan": "node --env-file-if-exists=.env.local --import tsx scripts/revoke-demo-wallet.ts --dry-run",
    "test": "vitest run",
    "test:attacks": "tsx scripts/run-attack-lab.ts",
    "test:watch": "vitest",
    "verify:testnet": "vitest run --config vitest.live.config.ts",
    "start": "tsx scripts/serve-demo.ts",
    "check:public": "node scripts/check-public-tree.mjs",
    "smoke:evidence": "node scripts/smoke-evidence.mjs"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "dependencies": {
    "@privy-io/node": "0.34.0",
    "viem": "^2.40.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "author": "Aisiweiyang",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aisiweiyang/alice-guard.git"
  },
  "bugs": {
    "url": "https://github.com/Aisiweiyang/alice-guard/issues"
  },
  "homepage": "https://github.com/Aisiweiyang/alice-guard#readme"
}
